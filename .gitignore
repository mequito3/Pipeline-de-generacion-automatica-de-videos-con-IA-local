# ─── CREDENCIALES — NUNCA SUBIR A GIT ───────────────────────────────────────
.env
*.env.local

# Google OAuth / YouTube API
client_secret*.json
youtube_client_secrets.json
youtube_token.json
*credentials*.json
*token*.json
service_account*.json

# Sesiones exportadas (contienen cookies de YouTube en base64)
export_session_output.txt
export_session.py

# ─── Estado interno del bot (datos operacionales, no código) ─────────────────
agent_memory.json
used_posts.json
used_posts_channel.json
analytics_log.json
growth_log.json
channel_id_cache.txt
topics_index.json
trends_cache.json

# ─── Output generado ─────────────────────────────────────────────────────────
output/
logs/

# ─── Perfiles Chrome (contienen cookies/sesión de Google) ────────────────────
chrome_profile/
chrome_profile_tiktok/

# ─── Caché de Pexels (videos descargados, pueden ser cientos de MB) ──────────
assets/pexels_cache/

# ─── Scripts de diagnóstico temporales ───────────────────────────────────────
check_bsod*.ps1
test_*.py

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
pip-wheel-metadata/

# ─── Entornos virtuales ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
.claude/settings.local.json
*.swp
*.swo
*~

# ─── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Archivos temporales de video/audio ──────────────────────────────────────
temp_audio.m4a
*.temp.*

# ─── Assets personalizados (no rastrear fuentes/música grandes) ───────────────
assets/fonts/*.ttf
assets/music/*.mp3
assets/music/*.wav
